{
  // Gemeinsame Projekteinstellungen (gelten nur in diesem Ordner)
  "files.encoding": "utf8",

  // LaTeX Workshop: pdfLaTeX über latexmk (biber wird automatisch aufgerufen)
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "pdfLaTeX (latexmk)",
      "tools": ["latexmk-pdf"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdf",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",

  // LTeX+: Berichtssprache britisches Englisch
  "ltex.language": "en-GB"
}
